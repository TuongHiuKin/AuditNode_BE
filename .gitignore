# ==============================================================================
# SECURITY & SECRETS (Zero-Knowledge Policy)
# ==============================================================================
# Ignore all environment-specific configurations
appsettings.json
appsettings.*.json

# Ignore local secrets and development certificates
secrets.json
*.pfx
*.pem
*.key

# EXPLICITLY ALLOW the blueprint template
!appsettings.example.json

# ==============================================================================
# BUILD & RUNTIME ARTIFACTS
# ==============================================================================
# C# Build outputs
[Bb]in/
[Oo]bj/
build_output/

# Logs and test results
*.log
TestResults/

# ==============================================================================
# OS & IDE METADATA
# ==============================================================================
# Editor folders
.vs/
.vscode/
.idea/

# User-specific files
*.user
*.suo

# Operating System artifacts
.DS_Store
Thumbs.db

# --- AUTO-DISCOVERED SECURITY RULES ---
# Environment files
.env
.env.*

# Local databases and backups
*.db
*.sqlite
*.bak
*.sql
*.mdf
*.ldf

# Certificates and keystores (extended)
*.crt
*.keystore
*.truststore

