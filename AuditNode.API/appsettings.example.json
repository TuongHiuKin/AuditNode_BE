{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Https": {
    "RedirectEnabled": true
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://localhost:3000"
    ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Host=localhost;Port=5432;Database=AuditNodeDb;Username=postgres;Password=your_password_here"
  },
  "Identity": {
    "Issuer": "AuditNode",
    "Audience": "auditnode-api",
    "SigningKey": "replace-with-a-random-secret-of-at-least-32-bytes",
    "BootstrapAdmin": {
      "Username": "admin",
      "Email": "admin@auditnode.local",
      "Password": "replace_with_a_strong_local_password"
    }
  }
}
